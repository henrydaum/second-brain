{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  /* This file only points at the two real configs — it compiles nothing itself.
     The alias is repeated here because tooling that reads the root config (and
     some editors) looks for it here rather than in the referenced projects. */
  "compilerOptions": {
    "paths": { "@/*": ["./src/*"] }
  }
}
