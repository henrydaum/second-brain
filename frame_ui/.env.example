# Development only: copy to .env.local (gitignored) and fill in.

# Where Second Brain is. **Used by the dev server's proxy, not by the browser.**
# The page always talks to its own origin — vite.config.js forwards /sdk,
# /events and /files here — so CORS never comes into it, and the value can be
# anything the dev server itself can reach: a loopback port today, a Tailscale
# hostname later (VITE_SB_URL=http://my-box.tail1234.ts.net:8787).
#
# That is worth knowing if you ever do point a browser straight at the server:
# `http_allowed_origins` is echoed into `Access-Control-Allow-Origin` verbatim,
# so it must match the Origin header exactly — no trailing slash, and
# `localhost` and `127.0.0.1` are different origins.
VITE_SB_URL=http://127.0.0.1:8787

# Second Brain's `secret_http_token`, set by /setup or via /config in the REPL.
# Every request the frontend serves carries it as `Authorization: Bearer <token>`,
# and the SSE stream carries it as `?token=` because EventSource cannot set a
# header. Without it the server answers 401 to everything.
VITE_SB_TOKEN=

# Which session this browser talks to. `?thread=main` keys the session
# `http:main`; two threads are two independent conversations, and only one
# stream may be open per thread — a second GET /events replaces the first.
VITE_SB_THREAD=main

# Where the dev server itself listens. Change it if 5174 is taken.
VITE_UI_PORT=5174
