# Optional overrides. The Vite proxy reads the kernel config.json by default.
# Credentials stay on the server; no VITE_SB_TOKEN is needed in the browser.
# VITE_SB_URL=http://127.0.0.1:8787
# VITE_UI_PORT=5174
# VITE_SB_THREAD=main
# SB_DATA_DIR can be set in the server process environment for another data dir.
